# Copia estas variables en Portainer (Stacks > tu stack > Environment variables).

# Usuario y contraseña de la primera cuenta. Solo se usan si la base de datos no tiene cuentas.
ADMIN_USER=roberto
ADMIN_PASSWORD=pon-aqui-una-contraseña-larga

# Puerto del servidor donde escucha la app (Cloudflare Tunnel apuntará aquí).
APP_PORT=8085

# auto (recomendado), true o false
COOKIE_SECURE=auto

# Registro de cuentas nuevas desde la pantalla de entrada.
#   codigo  (recomendado) solo quien sepa REGISTRO_CODIGO puede crearse una cuenta
#   abierto cualquiera con el enlace puede crearse una cuenta
#   cerrado nadie puede registrarse (las cuentas se crean desde Ajustes)
# Si REGISTRO=codigo y REGISTRO_CODIGO está vacío, el registro queda cerrado.
REGISTRO=codigo
REGISTRO_CODIGO=pon-aqui-un-codigo-que-solo-des-a-quien-quieras

# Solo si añades el servicio cloudflared al stack
# TUNNEL_TOKEN=
